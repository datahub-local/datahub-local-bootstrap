#!/bin/bash
#
# Keep only the newest {{ k3s_maintenance_helm_history_keep }} revision(s) of every Helm
# release, deleting the older sh.helm.release.v1.<release>.v<N> Secrets.
#
# Why this exists: a release Secret holds the whole rendered chart (~0.6-0.9 MB for traefik
# and argo-cd), and Argo CD's cluster cache must LIST every Secret in the cluster to build
# its resource tree. Ten revisions each of traefik, argo-cd and cert-manager made that list
# ~30 MB on 2026-10-16; the kube-apiserver could not stream it, and all ten Argo CD
# Applications reported sync=Unknown for an hour with nothing unhealthy in the cluster.
#
# Installed by the k3s_maintenance role, which also runs it: one implementation, so the
# timer and `playbook/maintenance.yml` cannot drift apart. Runs as root on the first server,
# through that node's own admin kubeconfig at /etc/rancher/k3s/k3s.yaml.
set -euo pipefail

keep={{ k3s_maintenance_helm_history_keep }}

kc() { {{ bin_dir }}/k3s kubectl "$@"; }

kc get secrets --all-namespaces -l owner=helm --no-headers \
  -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name' \
  | awk '{ rel = $2; sub(/\.v[0-9]+$/, "", rel); ver = $2; sub(/^.*\.v/, "", ver); print $1, rel, ver + 0, $2 }' \
  | sort -k1,1 -k2,2 -k3,3nr \
  | awk -v keep="$keep" '
      { key = $1 " " $2 }
      key == prev { count++ }
      key != prev { count = 1; prev = key }
      count > keep { print $1, $4 }' \
  | while read -r ns name; do
      echo "pruning $ns/$name"
      kc --namespace "$ns" delete secret "$name" --ignore-not-found
    done
